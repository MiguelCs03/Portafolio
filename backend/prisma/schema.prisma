generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  path      String
  target    String?
  referrer  String?
  userAgent String?
  device    String?
  country   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type])
  @@index([target])
}
